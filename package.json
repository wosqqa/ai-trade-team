{
  "name": "yuetuo-ai-crm-v1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "node --watch server/index.mjs",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "db:migrate": "node server/migrate.mjs",
    "test:api": "node server/tests/crm.mjs",
    "check:api": "node --check server/index.mjs && node --check server/crm.mjs && node --check server/migrate.mjs"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
