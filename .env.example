# Copy to .env locally. Never commit credentials. Generate API_TOKEN: openssl rand -hex 32
API_PORT=3001
API_TOKEN=
# Recommended: ssh -N -L 3307:127.0.0.1:3306 your-ssh-alias
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=yuetuo_trade
DB_USER=yuetuo_app
DB_PASSWORD=
# For TLS direct connection, supply trusted server CA path
DB_SSL_CA=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_CUSTOM_DOMAIN=
COS_PREFIX=trade
